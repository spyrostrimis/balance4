[gd_resource type="Resource" script_class="HintList" format=3]

[ext_resource type="Script" path="res://scripts/sim/missions/hint.gd" id="1_u3qry"]
[ext_resource type="Script" path="res://scripts/sim/missions/event_condition.gd" id="2_c2d7l"]
[ext_resource type="Script" path="res://scripts/sim/missions/hint_list.gd" id="3_rusl7"]

[sub_resource type="Resource" id="Resource_txof5"]
script = ExtResource("2_c2d7l")
event = &"select"

[sub_resource type="Resource" id="Resource_00jnq"]
script = ExtResource("1_u3qry")
id = &"select"
text = "Your harvester is the truck beside the refinery. Left-click it."
done_when = SubResource("Resource_txof5")

[sub_resource type="Resource" id="Resource_gbgie"]
script = ExtResource("2_c2d7l")
event = &"harvest"

[sub_resource type="Resource" id="Resource_8mhyj"]
script = ExtResource("1_u3qry")
id = &"harvest"
text = "Right-click the Orichalcum rock in the middle of the map (the gold patch on the minimap). Everything you build is paid for with Orichalcum."
done_when = SubResource("Resource_gbgie")

[sub_resource type="Resource" id="Resource_wbm83"]
script = ExtResource("2_c2d7l")
event = &"build"

[sub_resource type="Resource" id="Resource_21wlx"]
script = ExtResource("1_u3qry")
id = &"build"
text = "The build menu is at the right. Click Generator: your headquarters starts on it, and it is paid for bit by bit while it is built."
done_when = SubResource("Resource_wbm83")

[sub_resource type="Resource" id="Resource_6fx2y"]
script = ExtResource("2_c2d7l")
event = &"place"

[sub_resource type="Resource" id="Resource_fhm3p"]
script = ExtResource("1_u3qry")
id = &"place"
text = "When it is ready, click 'Place the Generator' and then a spot on the stony building ground by your headquarters. Green squares mean it fits."
done_when = SubResource("Resource_6fx2y")

[sub_resource type="Resource" id="Resource_gfx5u"]
script = ExtResource("2_c2d7l")
event = &"train"

[sub_resource type="Resource" id="Resource_cmfuy"]
script = ExtResource("1_u3qry")
id = &"train"
text = "Now build a Barracks and place it. It gets a tab of its own in the build menu: open it and click a soldier to train one."
done_when = SubResource("Resource_gfx5u")

[sub_resource type="Resource" id="Resource_u16ly"]
script = ExtResource("1_u3qry")
id = &"power"
text = "Buildings use power and Generators make it: use more than you make and everything builds at half speed. A Workshop builds more harvesters."

[resource]
script = ExtResource("3_rusl7")
hints = Array[ExtResource("1_u3qry")]([SubResource("Resource_00jnq"), SubResource("Resource_8mhyj"), SubResource("Resource_21wlx"), SubResource("Resource_fhm3p"), SubResource("Resource_cmfuy"), SubResource("Resource_u16ly")])
