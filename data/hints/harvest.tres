[gd_resource type="Resource" script_class="HintList" format=3]

[ext_resource type="Script" path="res://scripts/sim/missions/hint.gd" id="1_aepm6"]
[ext_resource type="Script" path="res://scripts/sim/missions/event_condition.gd" id="2_gi2no"]
[ext_resource type="Script" path="res://scripts/sim/missions/hint_list.gd" id="3_751ms"]

[sub_resource type="Resource" id="Resource_f20pn"]
script = ExtResource("2_gi2no")
event = &"select"

[sub_resource type="Resource" id="Resource_172c1"]
script = ExtResource("1_aepm6")
id = &"select"
text = "Your harvesters are the trucks beside the refinery. Left-click one, or drag a box around both."
done_when = SubResource("Resource_f20pn")

[sub_resource type="Resource" id="Resource_px23d"]
script = ExtResource("2_gi2no")
event = &"harvest"

[sub_resource type="Resource" id="Resource_rd8yv"]
script = ExtResource("1_aepm6")
id = &"harvest"
text = "Right-click the Orichalcum rock in the middle of the map (the gold patch on the minimap). The harvesters drive there and start work."
done_when = SubResource("Resource_px23d")

[sub_resource type="Resource" id="Resource_qh2oa"]
script = ExtResource("1_aepm6")
id = &"watch"
text = "The harvesters now work on their own: the robot fills the trailer, the truck takes it to the refinery. The refinery stores up to {storage}; when it is full they wait with their load."

[resource]
script = ExtResource("3_751ms")
hints = Array[ExtResource("1_aepm6")]([SubResource("Resource_172c1"), SubResource("Resource_rd8yv"), SubResource("Resource_qh2oa")])
