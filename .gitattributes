# Text files are stored with LF line endings, whatever the checkout platform.
* text=auto eol=lf

# Godot text formats
*.gd text eol=lf
*.gdshader text eol=lf
*.gdshaderinc text eol=lf
*.godot text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.import text eol=lf
*.cfg text eol=lf

# Other text
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.svg text eol=lf
*.txt text eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.blend binary
*.kra binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.res binary
*.scn binary
