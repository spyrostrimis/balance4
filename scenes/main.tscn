[node name="Hint" type="Label" parent="Center/Box"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.52, 0.47, 1)
theme_override_font_sizes/font_size = 12
text = "Mission 1: The First Claim (provisional name). Take the Orichalcum rock in the middle of the map.
Mission 2: Holding the Claim (provisional name). Dig in by the rock, beat off Red, and take its camp.
Harvest trial: a refinery and two harvesters, no enemy. Send them to the rock.
Raid trial: the same, with three soldiers, and raiders who come for the harvesters.
Base trial: a headquarters, a refinery and a harvester. Harvest, build and produce units.
Skirmish: the same base against a computer opponent with a base of its own. Destroy it.
Hero trial: the Prince and the Field Commander hold a base against three attacks. Esc quits."
horizontal_alignment = 1
